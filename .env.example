# Set these in the hosting environment before starting the service.
# This file is a template; the application does not automatically load .env files.
ASSEMBLYAI_API_KEY=
PUBLIC_ORIGIN=http://127.0.0.1:7863
MAX_VOICE_SECONDS=900
MAX_CONCURRENT_VOICE=2
# auto uses the prepared dialogue checkpoint and otherwise the local logistic fallback.
# transformer requires the checkpoint. local selects the earlier lightweight classifier.
ARGUMENT_RELATION_BACKEND=auto
# For deployment, replace with the absolute path of a mounted persistent volume.
# DATA_DIR=/data
